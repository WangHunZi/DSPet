# XIAO ESP32S3 Plus USB serial test image.
CONFIG_DSPET_SERIAL_SHELL=y
CONFIG_DSPET_CONSOLE_TESTS=y
# CONFIG_DSPET_AUDIO_CHECK is not set
# CONFIG_DSPET_PLAYBACK_DEMO is not set
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_DSPET_AEC=y
CONFIG_DSPET_LOCAL_VOICE=y
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y
