# Use together with sdkconfig.defaults and tests/sdkconfig.serial.defaults.
CONFIG_DSPET_DIRECT_TEST=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
# ESP-IDF #18640. I2S/GDMA can affect hardware hash and cipher operations.
# CONFIG_MBEDTLS_HARDWARE_SHA is not set
# CONFIG_MBEDTLS_HARDWARE_AES is not set
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="tests/partitions.direct.csv"
CONFIG_PARTITION_TABLE_FILENAME="tests/partitions.direct.csv"
